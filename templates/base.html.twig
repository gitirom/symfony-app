<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <!-- Font Awesome -->
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
            <style>
                * {
                    margin: 0;
                    padding: 0;
                    box-sizing: border-box;
                }

                body {
                    font-family: Arial, sans-serif;
                    line-height: 1.6;
                }

                .navbar {
                    background-color: #fff;
                    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
                    padding: 1rem 2rem;
                    position: fixed;
                    top: 0;
                    left: 0;
                    right: 0;
                    z-index: 1000;
                }

                .nav-container {
                    max-width: 1200px;
                    margin: 0 auto;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                }

                .navbar-brand img {
                    height: 35px;
                }

                .nav-menu {
                    display: flex;
                    list-style: none;
                    align-items: center;
                }

                .nav-item {
                    margin: 0 1.5rem;
                }

                .nav-link {
                    text-decoration: none;
                    color: #333;
                    font-weight: bold;
                    font-size: 1.1rem;
                    transition: color 0.3s ease;
                    cursor: pointer;
                }

                .nav-link:hover {
                    color: #FF424D;
                    border-bottom: 2px solid #FF424D;
                }

                .nav-right {
                    display: flex;
                    align-items: center;
                }

                .shop-icon {
                    font-size: 1.2rem;
                    color: #333;
                    text-decoration: none;
                    margin-left: 1.5rem;
                    transition: color 0.3s ease;
                    position: relative;
                    right: 40px;
                    cursor: pointer;
                }

                .shop-icon:hover {
                    color: #FF424D;
                }

                .hamburger {
                    display: none;
                    cursor: pointer;
                }

                .hamburger span {
                    display: block;
                    width: 25px;
                    height: 3px;
                    background-color: #333;
                    margin: 5px 0;
                    transition: all 0.3s ease;
                }

                @media (max-width: 768px) {
                    .hamburger {
                        display: block;
                    }

                    .nav-menu {
                        display: none;
                        width: 100%;
                        position: absolute;
                        top: 70px;
                        left: 0;
                        background-color: #fff;
                        padding: 1rem;
                        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
                        flex-direction: column;
                    }

                    .nav-menu.active {
                        display: flex;
                    }

                    .nav-item {
                        margin: 1rem 0;
                    }

                    .nav-right {
                        margin-top: 1rem;
                    }
                }

                main {
                    margin-top: 0; 
                }

                 .footer {
                    background-color: #333;
                    color: #fff;
                    padding: 4rem 2rem 0;
                    margin-top: 4rem;
                }

                .footer-content {
                    max-width: 1200px;
                    margin: 0 auto;
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                    gap: 2rem;
                    padding-bottom: 2rem;
                }

                .footer-section h3 {
                    color: #fff;
                    font-size: 1.2rem;
                    margin-bottom: 1.5rem;
                    position: relative;
                }

                .footer-section h3::after {
                    content: '';
                    position: absolute;
                    left: 0;
                    bottom: -8px;
                    width: 30px;
                    height: 2px;
                    background-color: #FF424D;
                }

                .footer-section p {
                    line-height: 1.6;
                    color: #ccc;
                }

                .footer-section ul {
                    list-style: none;
                    padding: 0;
                }

                .footer-section ul li {
                    margin-bottom: 1rem;
                }

                .footer-section ul li a {
                    color: #ccc;
                    text-decoration: none;
                    transition: color 0.3s ease;
                }

                .footer-section ul li a:hover {
                    color: #FF424D;
                }

                .footer-section ul li i {
                    margin-right: 10px;
                    color: #FF424D;
                }

                .social-links {
                    display: flex;
                    gap: 1rem;
                }

                .social-links a {
                    color: #fff;
                    background-color: #FF424D;
                    width: 35px;
                    height: 35px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    text-decoration: none;
                    transition: background-color 0.3s ease;
                }

                .social-links a:hover {
                    background-color: #ff2c39;
                }

                .footer-bottom {
                    text-align: center;
                    padding: 1.5rem;
                    background-color: #222;
                    color: #ccc;
                }

                @media (max-width: 768px) {
                    .footer-content {
                        grid-template-columns: 1fr;
                        text-align: center;
                    }

                    .footer-section h3::after {
                        left: 50%;
                        transform: translateX(-50%);
                    }

                    .social-links {
                        justify-content: center;
                    }

                    .footer-section ul li i {
                        margin-right: 5px;
                    }
                }

                /* Toast styles */
                .toast-container {
                    position: fixed;
                    top: 20px;
                    right: 20px;
                    z-index: 9999;
                }

                .toast {
                    background: white;
                    border-radius: 4px;
                    padding: 1rem;
                    margin-bottom: 0.5rem;
                    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
                    display: flex;
                    align-items: center;
                    animation: slideIn 0.3s ease-in-out;
                    max-width: 350px;
                    min-width: 300px;
                }

                .toast.success {
                    border-left: 4px solid #28a745;
                }

                .toast.error {
                    border-left: 4px solid #dc3545;
                }

                .toast.info {
                    border-left: 4px solid #17a2b8;
                }

                .toast-icon {
                    margin-right: 10px;
                    font-size: 1.2rem;
                }

                .toast.success .toast-icon {
                    color: #28a745;
                }

                .toast.error .toast-icon {
                    color: #dc3545;
                }

                .toast.info .toast-icon {
                    color: #17a2b8;
                }

                @keyframes slideIn {
                    from {
                        transform: translateX(100%);
                        opacity: 0;
                    }
                    to {
                        transform: translateX(0);
                        opacity: 1;
                    }
                }

                @keyframes fadeOut {
                    from {
                        opacity: 1;
                        transform: translateX(0);
                    }
                    to {
                        opacity: 0;
                        transform: translateX(100%);
                    }
                }

                .toast.hiding {
                    animation: fadeOut 0.3s ease-in-out forwards;
                }

                /* Dropdown styles */
                .dropdown {
                    position: relative;
                    display: inline-block;
                }

                .dropdown-menu {
                    display: none;
                    position: absolute;
                    right: 0; /* Position dropdown on the right */
                    background-color: #fff;
                    min-width: 200px;
                    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
                    border-radius: 4px;
                    padding: 0.5rem 0;
                    z-index: 1001;
                    list-style: none; /* Remove bullet points */
                }

                .dropdown-menu.show {
                    display: block;
                }

                .dropdown-item {
                    display: flex;
                    align-items: center;
                    justify-content: space-between; /* Move icon to the right */
                    padding: 0.7rem 1rem;
                    color: #333;
                    text-decoration: none;
                    transition: background-color 0.3s;
                }

                .dropdown-item span {
                    display: flex;
                    align-items: center;
                }

                .dropdown-item i {
                    margin-left: 10px; /* Space between text and icon */
                }

                .dropdown-item:hover {
                    background-color: #f8f9fa;
                    color: #FF424D;
                }

                .dropdown-divider {
                    margin: 0.5rem 0;
                    border-top: 1px solid #e9ecef;
                }

                .text-danger {
                    color: #dc3545;
                }

                .text-danger:hover {
                    background-color: #dc3545;
                    color: #fff;
                }

                .dropdown-toggle {
                    display: flex;
                    align-items: center;
                    gap: 5px;
                }

                .dropdown-toggle .fa-caret-down {
                    font-size: 0.8em;
                    transition: transform 0.3s ease;
                }

                .dropdown-toggle:hover .fa-caret-down {
                    transform: translateY(2px);
                }
            </style>
        {% endblock %}
    </head>
    <body>
        <nav class="navbar">
            <div class="nav-container">
                <a href="{{ path('app_home') }}" class="navbar-brand">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo">
                </a>
                
                <div class="hamburger" onclick="toggleMenu()">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <ul class="nav-menu">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('products_index') }}">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link">Blog</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" >Contact</a>
                    </li>
                    <li class="nav-item dropdown">
                        {% if app.user %}
                            <a class="nav-link dropdown-toggle" href="#" id="profileDropdown" role="button">
                                {{ app.user.firstName }} <i class="fas fa-caret-down"></i>
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_profile') }}">
                                        <span>Profile</span>
                                        <i class="fas fa-user"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_profile_products') }}">
                                        <span>Manage Products</span>
                                        <i class="fas fa-box"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_profile_settings') }}">
                                        <span>Settings</span>
                                        <i class="fas fa-cog"></i>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                        <span>Logout</span>
                                        <i class="fas fa-sign-out-alt"></i>
                                    </a>
                                </li>
                            </ul>
                        {% else %}
                            <a class="nav-link" href="{{ path('app_login') }}">Login</a>
                        {% endif %}
                    </li>
                    <li class="nav-item">
                        <a class="shop-icon">
                            <i class="fas fa-shopping-cart"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Add toast container -->
        <div class="toast-container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="toast {{ label }}" role="alert">
                        <i class="toast-icon fas 
                            {%- if label == 'success' -%}
                                fa-check-circle
                            {%- elseif label == 'error' -%}
                                fa-exclamation-circle
                            {%- else -%}
                                fa-info-circle
                            {%- endif -%}
                        "></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer class="footer">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>About Us</h3>
                    <p>We are dedicated to providing the best shopping experience with premium quality products and excellent customer service.</p>
                </div>
                
                <div class="footer-section">
                    <h3>Quick Links</h3>
                    <ul>
                        <li><a href="{{ path('app_home') }}">Home</a></li>
                        <li><a href="{{ path('products_index') }}">Products</a></li>
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3>Contact Info</h3>
                    <ul>
                        <li><i class="fas fa-phone"></i> +1 234 567 8900</li>
                        <li><i class="fas fa-envelope"></i> info@example.com</li>
                        <li><i class="fas fa-map-marker-alt"></i> 123 Street, City, Country</li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3>Follow Us</h3>
                    <div class="social-links">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2023 Your Company Name. All rights reserved.</p>
            </div>
        </footer>

        
               
        
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            <script>
                function toggleMenu() {
                    const navMenu = document.querySelector('.nav-menu');
                    navMenu.classList.toggle('active');
                }

                // Toast auto-dismiss
                document.addEventListener('DOMContentLoaded', function() {
                    const toasts = document.querySelectorAll('.toast');
                    toasts.forEach(toast => {
                        setTimeout(() => {
                            toast.style.opacity = '0';
                            toast.style.transform = 'translateX(100%)';
                            setTimeout(() => {
                                toast.remove();
                            }, 300);
                        }, 5000); // Increased to 5 seconds for better readability
                    });
                });

                // Dropdown toggle
                document.addEventListener('DOMContentLoaded', function() {
                    const dropdownToggle = document.getElementById('profileDropdown');
                    const dropdownMenu = dropdownToggle?.nextElementSibling;

                    if (dropdownToggle && dropdownMenu) {
                        dropdownToggle.addEventListener('click', function(e) {
                            e.preventDefault();
                            dropdownMenu.classList.toggle('show');
                        });

                        // Close dropdown when clicking outside
                        document.addEventListener('click', function(e) {
                            if (!dropdownToggle.contains(e.target) && !dropdownMenu.contains(e.target)) {
                                dropdownMenu.classList.remove('show');
                            }
                        });
                    }
                });
            </script>
        {% endblock %}
    </body>
</html>













